# Keep vendor keys and all token hashes on the server. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Generate unique credentials and paste only SHA-256 hashes into these lists.
VOICE_DEVICES='[{"device_id":"device-1","tenant_id":"account-1","profile_ids":["profile-1"],"character_ids":["buddy"],"token_sha256":"1631a62b1f120c1176fa5535e3fa9beb1f1b488355242c6ffd67e454157ac2a1","revoked":false}]'
VOICE_ADMINS='[{"tenant_id":"account-1","token_sha256":"1631a62b1f120c1176fa5535e3fa9beb1f1b488355242c6ffd67e454157ac2a1","revoked":false}]'
VOICE_HOST=127.0.0.1
VOICE_PORT=8787
VOICE_STORE_PATH=.voice-data/state.json
VOICE_PUBLIC_WS_URL=ws://127.0.0.1:8787/v1/voice/stream
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Leave empty on Vercel for independent WAV uploads with OPENAI_API_KEY + VOICE_DEVICES.
# Optional: HTTPS origin of a persistent backend for sessions, memory and WebSockets.
VOICE_SERVICE_URL=
# Native Vercel WebSockets: connect an Upstash Redis database for one-use tickets.
# On Vercel set VOICE_PUBLIC_WS_URL=wss://YOUR_BACKEND/api/voice/stream
# and keep VOICE_SERVICE_URL empty. History lasts only while connected.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: direct console API origin. Leave empty to use the same-origin proxy.
VITE_DEVICE_VOICE_API_URL=
